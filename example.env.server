G_CLIENT_ID=
G_CLIENT_SECRET=
JWT_SECRET=
INIT_TABLE=true
ENABLE_CACHE=true
PRODUCTHUNT_API_TOKEN=

# Shipping HOT provider modes: safe defaults
SHIPPING_DATA_MODE=mock
SHIPPING_RUNTIME_ENABLED=true
SHIPPING_VESSEL_PROVIDER=mock
SHIPPING_VESSEL_SEARCH_PROVIDER=mock
SHIPPING_PORT_PROVIDER=mock
SHIPPING_WEATHER_PROVIDER=mock
SHIPPING_WEATHER_ALERT_PROVIDER=off
SHIPPING_FEED_PROVIDER=mock
SHIPPING_CALENDAR_PROVIDER=mock
SHIPPING_AIS_PROVIDER=mock
SHIPPING_AIS_INTERVAL_MINUTES=15
SHIPPING_AIS_POSITION_TTL_MINUTES=15
SHIPPING_AIS_AREA_PROVIDER=off
SHIPPING_VOYAGE_PROVIDER=mock
SHIPPING_VOYAGE_INTERVAL_MINUTES=60

AISSTREAM_API_KEY=
CALENDARIFIC_API_KEY=

# Real Mode example (uncomment explicitly; keep the defaults above safe)
# SHIPPING_DATA_MODE=real
# SHIPPING_VESSEL_SEARCH_PROVIDER=vesselapi
# SHIPPING_VESSEL_PROVIDER=aisstream
# SHIPPING_PORT_PROVIDER=portcast
# SHIPPING_WEATHER_PROVIDER=open-meteo
# SHIPPING_WEATHER_ALERT_PROVIDER=public
# SHIPPING_FEED_PROVIDER=public
# SHIPPING_CALENDAR_PROVIDER=calendarific
# SHIPPING_AIS_PROVIDER=aisstream
# SHIPPING_VOYAGE_PROVIDER=xxx
# SHIPPING_AIS_AREA_PROVIDER=aisstream
# VESSELAPI_API_KEY=

# Environment Secret takes precedence; .data/provider-secrets.json is the local fallback.
