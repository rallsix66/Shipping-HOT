{
  "manifest_version": 3,
  "name": "Shipping HOT 人工剪藏",
  "version": "0.1.0",
  "minimum_chrome_version": "106",
  "description": "预览当前页或选区，送入本机 Shipping HOT 后由用户显式保存。",
  "key": "",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": { "default_popup": "popup.html" },
  "background": { "service_worker": "worker.js" },
  "externally_connectable": { "ids": [], "matches": ["http://127.0.0.1:5173/feed"] },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'; img-src 'none'" }
}
