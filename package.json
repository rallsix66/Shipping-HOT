{
  "name": "shipping-hot",
  "type": "module",
  "version": "0.0.41",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": "24.15.0",
    "pnpm": "10.30.3"
  },
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--use-env-proxy vite dev",
    "build": "vite build",
    "lint": "eslint",
    "start": "tsx ./scripts/start.ts",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.app.json",
    "prepare": "simple-git-hooks",
    "test": "vitest -c vitest.config.ts",
    "test:e2e": "node scripts/e2e-smoke.mjs",
    "smoke:p0-native": "node --import tsx/esm --experimental-loader ./scripts/tsx-alias-loader.mjs ./scripts/p0-native-sqlite-smoke.ts",
    "smoke:p2c-runtime": "node --import tsx/esm --experimental-loader ./scripts/tsx-alias-loader.mjs ./scripts/p2c-runtime-sqlite-smoke.ts",
    "smoke:p3a-ais": "node --import tsx/esm --experimental-loader ./scripts/tsx-alias-loader.mjs ./scripts/p3a-ais-sqlite-smoke.ts",
    "smoke:p3b-voyage": "node --import tsx/esm --experimental-loader ./scripts/tsx-alias-loader.mjs ./scripts/p3b-voyage-sqlite-smoke.ts",
    "smoke:p3-feed": "pnpm smoke:p3-feed-freshness",
    "smoke:p3-feed-freshness": "node --import tsx/esm --experimental-loader ./scripts/tsx-alias-loader.mjs ./scripts/p3-feed-freshness-sqlite-smoke.ts",
    "smoke:v3-real-activation": "node --import tsx/esm --experimental-loader ./scripts/tsx-alias-loader.mjs ./scripts/v3-real-activation-smoke.ts",
    "smoke:v3-readiness": "node --import tsx/esm --experimental-loader ./scripts/tsx-alias-loader.mjs ./scripts/v3-readiness.ts"
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.9.0",
    "@tanstack/react-router": "^1.163.2",
    "@unocss/reset": "^66.6.2",
    "better-sqlite3": "^12.6.2",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "consola": "^3.4.2",
    "dayjs": "1.11.13",
    "db0": "^0.3.1",
    "fast-xml-parser": "^5.4.1",
    "framer-motion": "^12.34.3",
    "h3": "^1.15.1",
    "jotai": "^2.18.0",
    "ofetch": "^1.5.1",
    "react": "^19.0.4",
    "react-dom": "^19.0.4",
    "react-use": "^17.6.0"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^2.13.0",
    "@iconify-json/ph": "^1.2.2",
    "@ourongxing/eslint-config": "3.2.3-beta.6",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/router-plugin": "^1.163.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@unocss/rule-utils": "^66.6.2",
    "@vitejs/plugin-react-swc": "^4.2.3",
    "cross-env": "^10.1.0",
    "dotenv": "^17.3.1",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "lint-staged": "^16.2.7",
    "rollup": "^4.59.0",
    "simple-git-hooks": "^2.13.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "unimport": "^6.0.0",
    "unocss": "^66.6.2",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-with-nitro": "0.0.3",
    "vitest": "^4.0.18",
    "workbox-build": "^7.4.0",
    "workbox-window": "^7.4.0"
  },
  "pnpm": {
    "patchedDependencies": {
      "dayjs": "patches/dayjs.patch",
      "vite-plugin-with-nitro@0.0.3": "patches/vite-plugin-with-nitro@0.0.3.patch",
      "prebuild-install@7.1.3": "patches/prebuild-install@7.1.3.patch"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "esbuild",
      "better-sqlite3",
      "sharp",
      "simple-git-hooks",
      "unrs-resolver"
    ],
    "overrides": {
      "vite-plugin-with-nitro>h3": "npm:h3-nightly@1.15.4-20250730-094032-325a62b",
      "nitro-go>h3": "npm:h3-nightly@1.15.4-20250730-094032-325a62b"
    }
  },
  "resolutions": {
    "cross-spawn": ">=7.0.6",
    "dayjs": "1.11.13",
    "db0": "^0.3.4",
    "nitropack": "npm:nitro-go@0.0.3",
    "picomatch": "^4.0.3",
    "react": "^19.0.4",
    "vite": "^7.3.1"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
